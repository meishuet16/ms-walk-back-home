{
  "name": "ms-walk-back-home",
  "private": true,
  "version": "0.1.0",
  "description": "Walk Back Home MVP monorepo",
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/html-prototype",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "authored:update": "node scripts/authored-content.mjs",
    "authored:check": "node scripts/authored-content.mjs --check",
    "verify": "npm run authored:check && npm run typecheck && npm test && npm run build && git diff --check",
    "hooks:install": "node scripts/install-hooks.mjs",
    "safe-push": "node scripts/safe-push.mjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:sync:cloud": "node scripts/android-cloud-sync.mjs",
    "android:assets": "node scripts/verify-capacitor-assets.mjs",
    "android:build": "npm run android:sync && npx cap build android"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "@types/node": "^22.13.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.1",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/share": "8.0.1"
  }
}
