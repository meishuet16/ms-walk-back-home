# Optional Supabase cloud sync for local/browser or Android builds.
# Copy this file to .env.android.local for an authenticated Android build.
# .env.android.local is ignored by Git. Never put service-role/admin/secret keys here.

WALK_BACK_HOME_AUTH_PROVIDER=supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=sb_publishable_YOUR_PUBLIC_CLIENT_KEY
SUPABASE_PRIVATE_MEDIA_BUCKET=walk-private-media
